{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.1.0",
  "identifier": "com.vox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Vox — Settings",
        "width": 560,
        "height": 620,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Voice dictation for macOS",
    "longDescription": "Vox is a macOS menu-bar app that lets you hold a hotkey, speak, and have the transcript pasted into the focused text field.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": []
    }
  },
  "plugins": {
    "globalShortcut": {},
    "store": {}
  }
}
